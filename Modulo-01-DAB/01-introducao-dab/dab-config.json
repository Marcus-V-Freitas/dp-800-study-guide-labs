{
    "$schema": "https://github.com/Azure/data-api-builder/releases/latest/download/dab.draft.schema.json",
    "data-source": {
        "database-type": "mssql",
        "connection-string": "@env('DATABASE_CONNECTION_STRING')"
    },
    "runtime": {
        "rest": {
            "enabled": true,
            "path": "/api"
        },
        "graphql": {
            "enabled": true,
            "path": "/graphql"
        },
        "host": {
            "mode": "development"
        }
    },
    "entities": {
        "Product": {
            "source": {
                "object": "dbo.Products",
                "type": "table"
            },
            "permissions": [
                {
                    "role": "anonymous",
                    "actions": ["*"]
                }
            ]
        }
    }
}
